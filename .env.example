# Copy to .env for local development. Never commit .env. Production values come from the host's
# secret store, not from a file in the repository.

# development | testing | production
APP_ENV=development

# Required in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# Required in production. Fernet key for the separate identity store.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IDENTITY_ENCRYPTION_KEY=

# Database. SQLite is fine for development; use PostgreSQL in production.
# DATABASE_URL=postgresql+psycopg://helplagbe:password@localhost:5432/helplagbe
DATABASE_URL=sqlite:///instance/help_lagbe.db

# Evidence is stored encrypted in the database. EVIDENCE_DIR is only read for files uploaded before that change.
EVIDENCE_DIR=instance/evidence
# Upload limit per request. Defaults to 4 on Vercel (its request limit is 4.5 MB) and 25 elsewhere.
# MAX_UPLOAD_MB=25

# Optional ClamAV daemon socket. Leave empty if no scanner is installed: files are then marked "not scanned".
CLAMD_SOCKET=

# Rate limiting store. memory:// is per-process; use Redis in production.
RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# Set to the number of reverse proxies in front of the app (0 when none).
TRUSTED_PROXY_COUNT=0

# Cookies: must be true in production (HTTPS only).
SESSION_COOKIE_SECURE=false
SESSION_HOURS=8

# Staff MFA (TOTP). Keep true. Set false only on a throwaway local machine.
MFA_REQUIRED_FOR_STAFF=true

# Seed fictional demo accounts/cases on first run (development only; ignored in production).
SEED_DEMO_DATA=true

# Retention: days after a case is resolved/closed before it appears in the retention review list.
DATA_RETENTION_DAYS_CLOSED_CASES=365

# Outbound email is NOT implemented; leaving this empty is expected.
MAIL_SERVER=

LOG_LEVEL=INFO
